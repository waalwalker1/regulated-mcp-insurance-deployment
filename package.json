{
  "name": "regulated-mcp-insurance-deployment",
  "version": "0.3.0",
  "private": true,
  "description": "Open-source reference architecture for deterministic, auditable insurance quotation workflows using MCP, Waniwani SDK, TypeScript, and PostgreSQL.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "setup": "npm install",
    "dev": "tsx apps/mcp-server/src/index.ts",
    "dev:pricing": "tsx apps/pricing-service/src/index.ts",
    "lint": "eslint \"apps/**/*.ts\" \"packages/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" --max-warnings=20",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\"",
    "test": "vitest run",
    "test:protocol": "vitest run tests/protocol",
    "test:integration": "vitest run tests/integration",
    "test:property": "vitest run tests/property.test.ts",
    "test:coverage": "vitest run --coverage",
    "eval": "tsx scripts/run-eval.ts",
    "demo": "tsx scripts/demo-flow.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "audit:verify": "tsx scripts/verify-audit.ts",
    "security": "npm audit --audit-level=high",
    "build": "tsc -b",
    "release-check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:coverage && npm run eval && npm run security"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "waniwani",
    "insurance",
    "insurtech",
    "regulated-workflows",
    "deterministic-ai",
    "typescript",
    "postgresql",
    "auditability",
    "enterprise-ai"
  ],
  "author": "Northstar Deployment Kit Contributors",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.17.19",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^3.0.7",
    "eslint": "^10.9.0",
    "fast-check": "^4.9.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "@waniwani/sdk": "^0.19.8",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "pg": "^8.23.0",
    "zod": "^3.24.2"
  }
}
