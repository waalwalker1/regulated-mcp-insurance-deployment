{
  "name": "regulated-mcp-insurance-deployment",
  "version": "0.1.0",
  "private": true,
  "description": "Regulated MCP Insurance Deployment Kit — Reference architecture for deterministic insurance quote funnels with server-owned validation, pricing, and auditability.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "setup": "npm install",
    "dev": "tsx apps/mcp-server/src/index.ts",
    "dev:pricing": "tsx apps/pricing-service/src/index.ts",
    "lint": "tsc --noEmit --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "eval": "tsx scripts/run-eval.ts",
    "demo": "tsx scripts/demo-flow.ts",
    "security": "npm audit --audit-level=high",
    "build": "tsc -b",
    "release-check": "npm run typecheck && npm run test && npm run eval && npm run security"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "insurance",
    "fintech",
    "typescript",
    "waniwani",
    "security",
    "forward-deployed-engineering"
  ],
  "author": "Northstar Deployment Kit Contributors",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.17.19",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "@waniwani/sdk": "^0.19.8",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "zod": "^3.24.2"
  }
}
