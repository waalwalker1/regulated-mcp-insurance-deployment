# Northstar Home Insurance EU — Regulated MCP Environment Configuration

# Server & MCP
NODE_ENV=development
PORT=3000
MCP_SERVER_NAME=northstar-insurance-mcp
MCP_SERVER_VERSION=0.1.0

# Pricing Service
PRICING_SERVICE_URL=http://localhost:3001
PRICING_SERVICE_PORT=3001

# Persistence (Default: memory for zero-credential instant local execution)
# Options: memory | postgres
PERSISTENCE_MODE=memory
SESSION_TTL_SECONDS=3600

# PostgreSQL (Only required if PERSISTENCE_MODE=postgres)
DATABASE_URL=postgresql://northstar:northstar_dev_pass@localhost:5432/northstar_quotes

# Audit & Logging
LOG_LEVEL=info
AUDIT_LOG_REDACTION=true

# Optional Upstream Integrations (Leave empty for zero-credential local mode)
# WANIWANI_API_KEY=
# WANIWANI_PLATFORM_URL=https://api.waniwani.ai
